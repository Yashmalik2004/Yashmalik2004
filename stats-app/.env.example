# ─────────────────────────────────────────────────────────────────────────────
# GitHub Stats Cards — Environment Variables Example
# Copy this file to .env.local for local testing (git-ignored)
# Or set these variables in your Vercel Dashboard settings.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED ─────────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic or fine-grained).
# Scopes needed: read:user, repo
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Upstash Redis (15-minute cache) ───────────────────────────────────
# If not set, the app uses an in-memory Map as fallback.
# Create a free database at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — Default username when ?username= param is omitted ─────────────────
DEFAULT_USERNAME=Yashmalik2004
